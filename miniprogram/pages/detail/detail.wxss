.page { padding-bottom: 60rpx; }
.gallery { width: 100%; height: 480rpx; background: #1A1215; }
.gallery.none {
  display: flex; align-items: center; justify-content: center;
  height: 260rpx; color: #6B5B5F; background: #241A1D; font-size: 26rpx;
}
.gimg { width: 100%; height: 480rpx; }

.head { padding: 26rpx 26rpx 28rpx; }
.line1 { display: flex; align-items: baseline; justify-content: space-between; }
.line1 .name { font-size: 40rpx; font-weight: 700; line-height: 1.35; flex: 1; }
.line1 .score { font-size: 40rpx; color: #7A1024; font-weight: 700; margin-left: 16rpx; }
.line1 .unit { font-size: 24rpx; font-weight: 400; }
.line2 { display: flex; align-items: center; gap: 16rpx; margin-top: 12rpx; flex-wrap: wrap; }
.tag { font-size: 22rpx; color: #fff; background: #7A1024; padding: 3rpx 16rpx; border-radius: 20rpx; }
.meta { font-size: 24rpx; color: #8C8C8C; }
.line3 { display: flex; align-items: center; gap: 14rpx; margin-top: 12rpx; }
.line3 .stars { font-size: 32rpx; }
.line3 .rec { font-size: 23rpx; color: #8C8C8C; }

.sec { margin-top: 26rpx; border-top: 1rpx dashed #E6DDD2; padding-top: 20rpx; }
.sech { font-size: 24rpx; color: #7A1024; font-weight: 600; margin-bottom: 10rpx; letter-spacing: 1rpx; }
.dishrow { display: flex; align-items: baseline; justify-content: space-between; padding: 8rpx 0; }
.dn { font-size: 29rpx; color: #1F1F1F; }
.dp { font-size: 27rpx; color: #B4761B; font-weight: 600; }
.kv { display: flex; gap: 16rpx; padding: 12rpx 0; align-items: flex-start; }
.kv .k { flex: none; width: 76rpx; font-size: 24rpx; color: #8C8C8C; }
.kv .v { flex: 1; font-size: 27rpx; color: #3A3A3A; word-break: break-all; }
.kv .v.red { color: #7A1024; font-weight: 600; }

.note {
  margin-top: 20rpx; background: #FCFAF7; border: 1rpx solid #E6DDD2;
  border-radius: 14rpx; padding: 20rpx; font-size: 26rpx; color: #4A4A4A;
  line-height: 1.7; white-space: pre-wrap;
}
.acts { display: flex; gap: 14rpx; margin-top: 26rpx; }
.acts .btn { flex: 1; }
.hint { font-size: 22rpx; color: #9A9A9A; text-align: center; padding: 24rpx 20rpx 0; line-height: 1.7; }
.loading { text-align: center; color: #8C8C8C; font-size: 26rpx; padding: 120rpx 0; }
.errbox { background: #FFF3F4; border: 1rpx solid #EFC9D1; border-radius: 18rpx; padding: 24rpx; }
.errbox .et { color: #8E1B30; font-size: 26rpx; margin-bottom: 16rpx; }
