.card.pad { padding: 22rpx 24rpx; }
.fld { margin-bottom: 26rpx; }
.fld:last-child { margin-bottom: 6rpx; }
.lab { font-size: 24rpx; color: #8C8C8C; margin-bottom: 10rpx; }
.lab .req { color: #7A1024; }
.tips { color: #A9A9A9; font-size: 21rpx; }
.ipt {
  width: 100%; height: 82rpx; background: #FCFAF7; border: 1rpx solid #E6DDD2;
  border-radius: 14rpx; padding: 0 20rpx; font-size: 29rpx; box-sizing: border-box;
}
.ta {
  width: 100%; min-height: 160rpx; background: #FCFAF7; border: 1rpx solid #E6DDD2;
  border-radius: 14rpx; padding: 18rpx 20rpx; font-size: 28rpx; box-sizing: border-box;
}
.cats { display: flex; gap: 12rpx; flex-wrap: wrap; margin-top: 14rpx; }
.cat {
  font-size: 24rpx; color: #4A4A4A; background: #fff; border: 1rpx solid #E6DDD2;
  border-radius: 24rpx; padding: 8rpx 22rpx;
}
.cat.on { background: #7A1024; border-color: #7A1024; color: #fff; }
.locrow { display: flex; gap: 14rpx; margin-top: 14rpx; }
.locrow .btn { flex: 1; height: 72rpx; font-size: 25rpx; }
.hint { font-size: 21rpx; color: #9A9A9A; line-height: 1.6; margin-top: 10rpx; }

.sech {
  font-size: 26rpx; color: #7A1024; font-weight: 600;
  margin-bottom: 18rpx; letter-spacing: 1rpx;
}
.fld.row { display: flex; align-items: center; justify-content: space-between; }
.fld.row .lab { margin-bottom: 0; }
.pickcell {
  background: #FCFAF7; border: 1rpx solid #E6DDD2; border-radius: 14rpx;
  padding: 14rpx 26rpx; font-size: 28rpx; color: #1F1F1F; min-width: 200rpx; text-align: center;
}
.starpick { display: flex; align-items: center; gap: 10rpx; }
.starpick .sp { font-size: 52rpx; color: #D8D0C4; line-height: 1; padding: 4rpx; }
.starpick .sp.on { color: #C9A227; }
.starpick .spval { font-size: 24rpx; color: #8C8C8C; margin-left: 10rpx; }

.drow { display: flex; gap: 12rpx; align-items: center; margin-bottom: 12rpx; }
.din {
  flex: 1; height: 76rpx; background: #FCFAF7; border: 1rpx solid #E6DDD2;
  border-radius: 12rpx; padding: 0 18rpx; font-size: 27rpx;
}
.dpri {
  width: 150rpx; height: 76rpx; background: #FCFAF7; border: 1rpx solid #E6DDD2;
  border-radius: 12rpx; padding: 0 16rpx; font-size: 27rpx; text-align: center;
}
.dx {
  width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center;
  color: #A9A9A9; font-size: 28rpx;
}
.addrow {
  margin-top: 10rpx; height: 72rpx; border: 1rpx dashed #C9BAA8; border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center; color: #7A1024; font-size: 26rpx;
}

.picks { display: flex; flex-wrap: wrap; gap: 14rpx; }
.pick {
  position: relative; width: 196rpx; height: 196rpx; border-radius: 14rpx; overflow: hidden;
  background: #F1EBE2;
}
.pimg { width: 100%; height: 100%; }
.pdel {
  position: absolute; right: 6rpx; top: 6rpx; width: 40rpx; height: 40rpx; border-radius: 20rpx;
  background: rgba(31,31,31,.6); color: #fff; font-size: 24rpx;
  display: flex; align-items: center; justify-content: center;
}
.pstat {
  position: absolute; left: 0; right: 0; bottom: 0; background: rgba(31,31,31,.55);
  color: #fff; font-size: 20rpx; text-align: center; padding: 6rpx 0;
}
.pstat.fail { background: rgba(160,34,59,.85); }
.pick.add {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  border: 1rpx dashed #C9BAA8; background: #FBF7F1; color: #A9967F;
}
.pick.add .plus { font-size: 46rpx; line-height: 1; }
.pick.add .ptext { font-size: 21rpx; margin-top: 6rpx; }

.savebar { display: flex; gap: 16rpx; margin-top: 8rpx; }
.btn.big { height: 92rpx; font-size: 31rpx; flex: 1; }
.btn.danger { color: #A0223B; border-color: #EBCFD6; background: #FFF7F8; flex: 0 0 180rpx; }
