.topbar {
  position: sticky; top: 0; z-index: 20;
  display: flex; align-items: center; gap: 16rpx;
  padding: 18rpx 24rpx 12rpx;
  background: #F6F2EC;
}
.search {
  flex: 1; display: flex; align-items: center; gap: 10rpx;
  background: #fff; border: 1rpx solid #E6DDD2; border-radius: 16rpx;
  padding: 0 20rpx; height: 78rpx;
  box-shadow: 0 4rpx 14rpx rgba(31,31,31,.05);
}
.search .ico { font-size: 26rpx; color: #B9A88F; }
.search .ipt { flex: 1; font-size: 27rpx; height: 78rpx; }
.gear {
  width: 78rpx; height: 78rpx; border-radius: 16rpx; background: #fff;
  border: 1rpx solid #E6DDD2; display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; color: #7A1024;
}

.chips {
  white-space: nowrap; padding: 4rpx 24rpx 16rpx;
}
.chip {
  display: inline-block; padding: 10rpx 26rpx; margin-right: 14rpx;
  background: #fff; border: 1rpx solid #E6DDD2; border-radius: 30rpx;
  font-size: 25rpx; color: #4A4A4A;
}
.chip.on { background: #7A1024; border-color: #7A1024; color: #fff; }

.card .cover { width: 100%; height: 300rpx; display: block; background: #EEE8E0; }
.card .cover.none {
  display: flex; align-items: center; justify-content: center;
  color: #B9AA98; font-size: 25rpx;
}
.card .body { padding: 20rpx 24rpx 24rpx; }
.line1 { display: flex; align-items: baseline; justify-content: space-between; }
.line1 .name { font-size: 34rpx; font-weight: 600; line-height: 1.35; }
.line1 .score { font-size: 34rpx; color: #7A1024; font-weight: 700; }
.line1 .unit { font-size: 22rpx; font-weight: 400; margin-left: 2rpx; }
.line2 { display: flex; align-items: center; gap: 14rpx; margin-top: 8rpx; flex-wrap: wrap; }
.tag {
  font-size: 22rpx; color: #fff; background: #7A1024;
  padding: 2rpx 14rpx; border-radius: 20rpx;
}
.meta { font-size: 23rpx; color: #8C8C8C; }
.line3 { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; }
.line3 .stars { font-size: 26rpx; }
.line3 .rec { font-size: 22rpx; color: #8C8C8C; }
.dishes { display: flex; gap: 10rpx; margin-top: 10rpx; align-items: flex-start; }
.dishes .dlab {
  flex: none; font-size: 22rpx; color: #7A1024; background: #FCF3F5;
  border: 1rpx solid #F1D9DF; border-radius: 8rpx; padding: 2rpx 10rpx;
}
.dishes .dtext { font-size: 25rpx; color: #4A4A4A; }
.addr { font-size: 24rpx; color: #6B6B6B; margin-top: 10rpx; }
.acts { display: flex; gap: 14rpx; margin-top: 18rpx; }
.acts .btn { flex: 1; }

.errbox {
  background: #FFF3F4; border: 1rpx solid #EFC9D1; border-radius: 18rpx;
  padding: 24rpx; margin-bottom: 20rpx;
}
.errbox .et { color: #8E1B30; font-size: 26rpx; line-height: 1.6; margin-bottom: 16rpx; }
.btn.small { height: 68rpx; font-size: 25rpx; }
.loading { text-align: center; color: #8C8C8C; font-size: 26rpx; padding: 60rpx 0; }
