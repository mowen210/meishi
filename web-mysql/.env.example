# 复制为 .env 后按实际修改：copy .env.example .env（Windows）
# ------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# 管理口令：新增/修改/删除/上传都要它，上线务必改成足够长的随机串
ADMIN_TOKEN=change-me

# MySQL 连接
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=canyin
MYSQL_POOL=10
